# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
!**/.env.example

# GCP / Firebase service accounts
**/service-account*.json
**/*-service-account.json
**/credentials.json

# Android signing
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
!**/*.pem.example

# Firebase client config (copy from .example after Firebase Console download)
flutter_app/lib/config/firebase_options.dart
flutter_app/android/app/google-services.json
flutter_app/ios/Runner/GoogleService-Info.plist
**/google-services.json
!**/google-services.json.example

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build / generated ---
build/
dist/
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
.pub-cache/
.pub/
**/coverage/
.firebase/

# --- IDE / OS ---
.DS_Store
Thumbs.db
*.swp
*.log
.cursor/debug*.log

