{
  "functions": {
    "source": "legacy/functions-ts/functions",
    "predeploy": [
      "npm --prefix legacy/functions-ts/functions run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "legacy/capacitor-web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/deleteAccountRequest",
        "function": "deleteAccountRequest"
      }
    ]
  }
}
