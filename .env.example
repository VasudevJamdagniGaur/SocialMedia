# Local secrets — copy to `.env` (gitignored). Never commit `.env`.

# Flutter app (`--dart-define-from-file=.env` or pass individually)
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
BACKEND_URL=https://detea-backend.onrender.com
NEWSAPI_KEY=your_newsapi_key_here

# Dart server (also see server/.env.example)
VERTEX_BACKEND_URL=https://detea-backend.onrender.com
GOOGLE_APPLICATION_CREDENTIALS=server/service-account.json
