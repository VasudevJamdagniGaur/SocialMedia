# Deite Dart server — copy to `.env` in this folder or set on Render/host.

PORT=3002
# Must be my-socitea (never offgrid-492919 — that project is invalid for Vertex).
GOOGLE_CLOUD_PROJECT=my-socitea
FIREBASE_PROJECT_ID=deitedatabase
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# Path to GCP service account JSON (Vertex + Firestore deleteRequests)
# On Render, prefer GOOGLE_CREDENTIALS=<full JSON> instead; server writes service-account.json at boot.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Backend API keys (server-side only — never in Flutter)
OPENAI_API_KEY=your_openai_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional LinkedIn OAuth (legacy share flow)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
